<ul>
HTML
  for app in $APPS; do
    [ -L "$ROOT/www/$app" ] || continue
    v=$(basename "$(readlink "$ROOT/www/$app")")
    app_info "$app"
    read -r _ odir _ _ orel <<<"$(override "$app")"
    if [ -n "${odir:-}" ] && [ "$v" = "$odir" ]; then
      extra=$(printf '<em title="Carries fixes not in a storytold release yet">patched</em><a class="w" href="%s">What&#39;s patched</a>' "$orel")
      v=${v%-z*}
    else
      extra=""
    fi
    # crash recovery we've checked: EffectCraft and FilmCraft have their own (our patches fix it on
    # Safari); the others only get it from our patches (craft-web-recovery). LightCraft isn't
    # labelled until its web autosave has been tested.
    case $app in
      effectcraft|filmcraft) rec=1 ;;
      photocraft|vectorcraft|wordcraft|deckcraft|designcraft|cadcraft|gridcraft|pdfcraft|soundcraft)
        [ -n "$extra" ] && rec=1 || rec=0 ;;
      *) rec=0 ;;
    esac
    if [ $rec = 1 ]; then
      rec='<p class="r ok">&#10003; Autosave: recovers unsaved work</p>'
    else
      rec='<p class="r"></p>'
    fi
    if [ -f "$ROOT/www/icons/$app.png" ]; then
      T=$(printf '<img class="i" src="/icons/%s.png?v=%s" alt="" width="52" height="52">' "$app" "$(date -r "$ROOT/www/icons/$app.png" +%s)")
    else
      T="<span class=\"i\" aria-hidden=\"true\">$T</span>"
    fi
    printf '<li class="a-%s"><div class="h">%s<div><h2><a href="/%s/">%s</a></h2><span class="k">%s</span></div></div><p class="d">%s</p>%s<div class="f"><span>v%s</span>%s<span class="go" aria-hidden="true">Open &rarr;</span></div></li>\n' \
      "$app" "$T" "$app" "$N" "$K" "$D" "$rec" "$v" "$extra"
  done
  cat <<'HTML'
